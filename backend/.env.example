# ------------------------------------------------------------------
# Microcontroller AI Lab backend configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------
# AI provider (all AI calls are proxied through this backend)
# This project is configured for the Anthropic Claude API.
#   Endpoint : POST https://api.anthropic.com/v1/messages
#   Auth     : x-api-key header (server-side only)
# ------------------------------------------------------------------
AI_PROVIDER=anthropic
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com/v1
# Set AI_MODEL to a model your key has access to. Examples:
#   claude-sonnet-4-5, claude-opus-4-7, claude-haiku-4-5
AI_MODEL=claude-sonnet-4-5
AI_TIMEOUT_MS=30000
# Anthropic Messages API requires max_tokens.
AI_MAX_TOKENS=1024
# NOTE: the newest Claude models reject temperature. Leave this blank to omit it;
# set a value only for models that support sampling parameters.
AI_TEMPERATURE=

# ------------------------------------------------------------------
# Optional: provider usage / cost API (Anthropic Admin API)
#
# Anthropic exposes usage and cost via the Admin "Usage & Cost" API. This
# requires a SEPARATE Admin API key (sk-ant-admin...), NOT the normal API key,
# and reports ORGANIZATION-level usage (not scoped to a single API key).
#
# Leave this disabled to show APPLICATION-TRACKED usage only, recorded by this
# backend while using AI_API_KEY.
#
#   GET /v1/organizations/usage_report/messages
#   GET /v1/organizations/cost_report
# ------------------------------------------------------------------
AI_USAGE_API_ENABLED=false
AI_USAGE_API_KEY=
AI_USAGE_BASE_URL=https://api.anthropic.com/v1
# "account" (org/project scope) or "key" (key-scoped; rarely available)
AI_USAGE_SCOPE=account

# ------------------------------------------------------------------
# Usage dashboard access control
# For this local bootcamp prototype the usage endpoints are restricted
# to localhost. Set to "false" only behind your own authentication.
# ------------------------------------------------------------------
USAGE_LOCALHOST_ONLY=true
